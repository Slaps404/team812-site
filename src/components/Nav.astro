---
interface Props {
  current: 'home' | 'sponsors';
}
const { current } = Astro.props;
---
<nav class="nav">
  <div class="nav-in">
    <a class="mark" href="/"><b>812</b><span>Midnight Mechanics</span></a>
    <a class:list={['link', { on: current === 'home' }]} href="/" aria-current={current === 'home' ? 'page' : undefined}>Home</a>
    <a class:list={['link', { on: current === 'sponsors' }]} href="/sponsors" aria-current={current === 'sponsors' ? 'page' : undefined}>Sponsors</a>
    <a class="link soon" title="Section not yet available">Robots</a>
    <a class="link soon" title="Section not yet available">Team</a>
    <a class="btn" href="/sponsors">Sponsor us</a>
  </div>
</nav>
