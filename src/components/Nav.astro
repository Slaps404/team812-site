---
import badge from '../assets/logos/team812-badge.png';

interface Props {
  current: 'home' | 'sponsors' | 'robots' | 'team' | 'contact';
}
const { current } = Astro.props;

/* The badge is the team's official logo, pulled from themidnightmechanics.com.
   Its ring text ("DON'T YOU PANIC / I'M A MIDNIGHT MECHANIC") is illegible at
   nav size, which is fine: the badge works as a shape here and the wordmark
   beside it carries the name. That is also why the alt text names the team
   rather than transcribing the ring. Size lives in the .mark img rule. */
---
<nav class="nav">
  <div class="nav-in">
    <a class="mark" href="/" data-astro-prefetch>
      {/* The source is 1500px wide but the nav slot is ~44px. width is pinned to
          3x that so the emitted asset is a few kB instead of the full-size logo,
          and still sharp on high-density screens. */}
      <img src={badge.src} alt="Team 812 badge" width="132" height="139" loading="eager" decoding="async" />
      <span>The Midnight Mechanics</span>
    </a>
    <div class="nav-links" aria-label="Primary">
      <a class:list={['link', { on: current === 'home' }]} href="/" data-astro-prefetch aria-current={current === 'home' ? 'page' : undefined}>Home</a>
      <a class:list={['link', { on: current === 'sponsors' }]} href="/sponsors" data-astro-prefetch aria-current={current === 'sponsors' ? 'page' : undefined}>Sponsors</a>
      <a class:list={['link', { on: current === 'robots' }]} href="/robots" data-astro-prefetch aria-current={current === 'robots' ? 'page' : undefined}>Robots</a>
      <a class:list={['link', { on: current === 'team' }]} href="/team" data-astro-prefetch aria-current={current === 'team' ? 'page' : undefined}>Team</a>
      <a class:list={['link', { on: current === 'contact' }]} href="/contact" data-astro-prefetch aria-current={current === 'contact' ? 'page' : undefined}>Contact</a>
    </div>
  </div>
</nav>
