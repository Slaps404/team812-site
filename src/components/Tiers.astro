---
import { getCollection, type CollectionEntry } from 'astro:content';

const tiers = (await getCollection('tiers')).sort((a, b) => a.data.order - b.data.order);
---
<div class="tiers">
  {tiers.map((t: CollectionEntry<'tiers'>) => (
    <div class:list={['tier', { top: t.data.top }]} data-reveal>
      <div class="amt">{t.data.amount}</div>
      {t.data.precede && <p class="tier-precede">{t.data.precede}</p>}
      <ul>
        {t.data.items.map((item: string) => (
          <li set:html={item} />
        ))}
      </ul>
    </div>
  ))}
</div>
