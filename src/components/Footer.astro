---
import badge from '../assets/logos/team812-badge.png';

const preussLogo = 'https://brand.ucsd.edu/_images/logos-and-brand-elements/additional-campus-logos/preuss-school-logo.svg';
---

  <footer>
    <div class="wrap footer-banner">
      <div class="footer-brand">
        <a class="footer-team-mark" href="/" aria-label="The Midnight Mechanics home">
          <img src={badge.src} alt="The Midnight Mechanics, FRC Team 812" width="150" height="150" loading="lazy" decoding="async" />
        </a>
        <div class="footer-brand-copy">
          <p class="footer-kicker">FRC TEAM 812</p>
          <p class="footer-team-name">The Midnight Mechanics</p>
          <a class="footer-school-logo" href="https://preuss.ucsd.edu/index.html" target="_blank" rel="noopener">
            <img src={preussLogo} alt="The Preuss School UC San Diego" width="80" height="93" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
          </a>
        </div>
      </div>

      <div class="footer-contact">
        <a class="footer-contact-link" href="mailto:team812@preuss.ucsd.edu">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m4 7 8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
          <span>team812@preuss.ucsd.edu</span>
        </a>
      </div>

      <nav class="footer-links" aria-label="Team social links">
        <a class="footer-social-link" href="https://github.com/preuss812" target="_blank" rel="noopener" aria-label="Team 812 on GitHub">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.04c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.74.08-.74 1.2.09 1.83 1.23 1.83 1.23 1.07 1.83 2.8 1.3 3.48.99.11-.77.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.94 0-1.31.47-2.38 1.23-3.22-.12-.3-.53-1.52.12-3.17 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.3-1.55 3.3-1.23 3.3-1.23.65 1.65.24 2.87.12 3.17.77.84 1.23 1.91 1.23 3.22 0 4.61-2.8 5.63-5.48 5.93.43.37.81 1.1.81 2.22v3.29c0 .32.22.69.83.57A12 12 0 0 0 12 .5Z"/></svg>
          <span>GitHub <small>preuss812</small></span>
        </a>
        <a class="footer-social-link" href="https://instagram.com/midnightmechanics" target="_blank" rel="noopener" aria-label="Midnight Mechanics on Instagram">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.4" cy="6.7" r="1.1" fill="currentColor"/></svg>
          <span>Instagram <small>@midnightmechanics</small></span>
        </a>
      </nav>
      <p class="chant" id="footer-chant">
        <span class="chant-word" id="word-what">What</span>
        <span class="chant-word" id="word-time">time</span>
        <span class="chant-karaoke-word" id="word-is">is</span>
        <span class="chant-word" id="word-it">it?...</span>
        <span class="chant-word chant-highlight" id="midnight-word">Midnight!</span>
      </p>
    </div>
  </footer>

  <script>
    const setupChant = () => {
      const chant = document.getElementById('footer-chant');
      if (!chant) return;

      const wordWhat = document.getElementById('word-what');
      const wordTime = document.getElementById('word-time');
      const wordIs = document.getElementById('word-is');
      const wordIt = document.getElementById('word-it');
      const midnightWord = document.getElementById('midnight-word');

      if (wordIs) wordIs.textContent = "is";

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            observer.unobserve(entry.target);

            // 1. "What" lights up
            setTimeout(() => {
              wordWhat?.classList.add('is-active');
            }, 150);

            // 2. "time" lights up
            setTimeout(() => {
              wordTime?.classList.add('is-active');
            }, 350);

            // 3. "is" turns into "isss" and smoothly sweeps highlight across it
            setTimeout(() => {
              if (wordIs) {
                wordIs.textContent = "isss";
                const startTime = performance.now();
                const duration = 450; // fast & snappy 450ms sweep

                const animateFill = (now: number) => {
                  const elapsed = now - startTime;
                  const progress = Math.min(100, (elapsed / duration) * 100);
                  wordIs.style.setProperty('--fill-pct', `${progress}%`);

                  if (progress < 100) {
                    requestAnimationFrame(animateFill);
                  } else {
                    wordIs.classList.add('is-active');

                    // 4. "it?..." lights up
                    setTimeout(() => {
                      wordIt?.classList.add('is-active');

                      // 5. Short punchy suspense pause then BAM: "Midnight!"
                      setTimeout(() => {
                        midnightWord?.classList.add('is-active');
                      }, 400);
                    }, 200);
                  }
                };
                requestAnimationFrame(animateFill);
              }
            }, 600);
          }
        });
      }, { threshold: 0.2 });

      observer.observe(chant);
    };
    document.addEventListener('astro:page-load', setupChant);
  </script>
