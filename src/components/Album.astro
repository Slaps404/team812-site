---
import { Image } from 'astro:assets';
import { CONTENT_IMAGE_WIDTHS, SPLIT_IMAGE_SIZES } from '../lib/imageLayout';

export interface PhotoItem {
  src: ImageMetadata;
  alt: string;
  caption: string;
  isTransparent?: boolean;
}

interface Props {
  photos?: PhotoItem[];
  year: number;
}

const { photos = [], year } = Astro.props;
const hasPhotos = photos.length > 0;
const hasMultiple = photos.length > 1;
const isFirstTransparent = photos[0]?.isTransparent ?? false;
---

{hasPhotos ? (
  <div class="robot-album" data-album>
    <figure class:list={['shot robot-album-main', { 'transparent-machine': isFirstTransparent }]}>
      <Image
        class="robot-album-main-img"
        src={photos[0].src}
        alt={photos[0].alt}
        data-gallery-id={photos[0].src.src}
        widths={CONTENT_IMAGE_WIDTHS}
        sizes={SPLIT_IMAGE_SIZES}
        loading="eager"
        fetchpriority="high"
      />
      {hasMultiple && (
        <div class="robot-album-controls" aria-label={`${year} season photo controls`}>
          <button class="hero-arrow robot-album-arrow" type="button" data-album-prev aria-label="Previous robot photo">
            <span aria-hidden="true">&#8592;</span>
          </button>
          <button class="hero-arrow robot-album-arrow" type="button" data-album-next aria-label="Next robot photo">
            <span aria-hidden="true">&#8594;</span>
          </button>
        </div>
      )}
      <figcaption class="mono robot-album-caption">{photos[0].caption}</figcaption>
    </figure>

    {hasMultiple && (
      <div class="robot-album-thumbs" role="tablist" aria-label={`${year} season photo album`}>
        {photos.map((photo, idx) => (
          <button
            type="button"
            class:list={['robot-album-thumb', { active: idx === 0 }]}
            data-index={idx}
            data-src={photo.src.src}
            data-alt={photo.alt}
            data-caption={photo.caption}
            data-transparent={photo.isTransparent ? 'true' : 'false'}
            role="tab"
            aria-selected={idx === 0 ? 'true' : 'false'}
            aria-label={`View photo: ${photo.caption}`}
          >
            <Image
              src={photo.src}
              alt=""
              width={160}
              height={120}
              loading="lazy"
            />
          </button>
        ))}
      </div>
    )}
  </div>
) : (
  <div class="robot-detail-empty" role="status">
    <p class="empty-heading">No photographic record on file.</p>
    <p class="body empty-sub">Historical match logs and public code for the {year} season remain archived.</p>
  </div>
)}

<script>
  const setupAlbums = () => {
    document.querySelectorAll('[data-album]').forEach((album) => {
      if ((album as HTMLElement).dataset.albumSetup === 'true') return;
      (album as HTMLElement).dataset.albumSetup = 'true';

      const mainFig = album.querySelector('.robot-album-main');
      const mainImg = album.querySelector('.robot-album-main-img') as HTMLImageElement;
      const caption = album.querySelector('.robot-album-caption');
      const thumbs = [...album.querySelectorAll('.robot-album-thumb')];
      let current = 0;

      const show = (index: number) => {
        current = (index + thumbs.length) % thumbs.length;
        thumbs[current]?.dispatchEvent(new Event('click'));
      };

      thumbs.forEach((thumb) => {
        thumb.addEventListener('click', () => {
          current = Number(thumb.getAttribute('data-index') ?? 0);
          thumbs.forEach((t) => {
            t.classList.remove('active');
            t.setAttribute('aria-selected', 'false');
          });
          thumb.classList.add('active');
          thumb.setAttribute('aria-selected', 'true');

          const newSrc = thumb.getAttribute('data-src');
          const newAlt = thumb.getAttribute('data-alt');
          const newCaption = thumb.getAttribute('data-caption');
          const isTrans = thumb.getAttribute('data-transparent') === 'true';

          if (mainFig) {
            if (isTrans) {
              mainFig.classList.add('transparent-machine');
            } else {
              mainFig.classList.remove('transparent-machine');
            }
          }

          if (mainImg && newSrc) {
            mainImg.src = newSrc;
            mainImg.removeAttribute('srcset');
            if (newAlt) mainImg.alt = newAlt;
            mainImg.setAttribute('data-gallery-id', newSrc);
          }
          if (caption && newCaption) {
            caption.textContent = newCaption;
          }
        });
      });

      album.querySelector('[data-album-prev]')?.addEventListener('click', () => show(current - 1));
      album.querySelector('[data-album-next]')?.addEventListener('click', () => show(current + 1));
      mainFig?.addEventListener('keydown', (event) => {
        const key = (event as KeyboardEvent).key;
        if (key === 'ArrowLeft') show(current - 1);
        if (key === 'ArrowRight') show(current + 1);
      });
    });
  };

  document.addEventListener('astro:page-load', setupAlbums);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupAlbums);
  } else {
    setupAlbums();
  }
</script>
