---
import { Image } from 'astro:assets';
import heroImg from '../assets/photos/2026-states-IMG_1045.jpg';
import { HERO_IMAGE_SIZES, HERO_IMAGE_WIDTHS } from '../lib/imageLayout';
---
<header class="hero">
  <Image
    class="hero-image"
    src={heroImg}
    alt="A Team 812 student and mentor working on the robot in the pit at the 2026 state championship."
    data-gallery-id="team-812-robot-pit"
    widths={HERO_IMAGE_WIDTHS}
    sizes={HERO_IMAGE_SIZES}
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero-scrim" aria-hidden="true"></div>
  <div class="hero-content" data-reveal>
    <p class="mono">Team 812 &nbsp;/&nbsp; The Preuss School UC San Diego</p>
    <h1>25 seasons of first-generation engineers.</h1>
    <div class="cta">
      <a class="btn solid" href="/sponsors">Sponsor Our 2027 Season</a>
      <a class="btn ghost" href="https://github.com/preuss812" target="_blank" rel="noopener">Read Our Robot Code</a>
    </div>
  </div>
</header>
