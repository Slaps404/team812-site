---
import { Image } from 'astro:assets';
import teamImg from '../assets/photos/2026-states-team-hotel-hero.jpg';
import arenaTeamRobotImg from '../assets/photos/2026-states-team-robot-arena.jpg';
import fieldCloseImg from '../assets/photos/2026-states-robot-field-close.jpg';
import robotTeamImg from '../assets/photos/2026-states-robot-team.jpg';
import { HERO_IMAGE_SIZES, HERO_IMAGE_WIDTHS } from '../lib/imageLayout';

/* Order matters: the first slide is the LCP image, so it is the one that gets
   eager loading and high fetch priority. Everything after it waits. */
const slides = [
  {
    src: teamImg,
    alt: 'Team 812 members in matching team shirts posing together in a hotel lobby.',
    id: 'team-812-hotel-team',
  },
  {
    src: fieldCloseImg,
    alt: "Team 812's competition robot collecting yellow game pieces beside the field wall.",
    id: 'team-812-robot-field-close',
  },
  {
    src: arenaTeamRobotImg,
    alt: 'Team 812 members posing with their competition robot in the arena at a REBUILT event.',
    id: 'team-812-arena-team-robot',
  },
  {
    src: robotTeamImg,
    alt: 'Team 812 students and a mentor moving their competition robot through the arena.',
    id: 'team-812-robot-team',
  },
];
---
{/* Full-bleed competition photos cross-fade when a visitor uses the controls,
    so the hero runs dark: the scrim carries the bottom of the frame down to the
    page ground and the headline sits on it. The scrim and headline stay put
    across slides. */}
<header class="hero">
  <div class="hero-slides" aria-roledescription="carousel" aria-label="Team 812 at the 2026 competition">
    {slides.map((slide, index) => (
      <div
        class:list={['hero-slide', { 'is-active': index === 0 }]}
        aria-hidden={index === 0 ? undefined : 'true'}
      >
        <Image
          class="hero-image"
          src={slide.src}
          alt={slide.alt}
          data-gallery-id={slide.id}
          widths={HERO_IMAGE_WIDTHS}
          sizes={HERO_IMAGE_SIZES}
          loading={index === 0 ? 'eager' : 'lazy'}
          fetchpriority={index === 0 ? 'high' : 'low'}
        />
      </div>
    ))}
  </div>
  <div class="hero-scrim" aria-hidden="true"></div>
  <div class="hero-content" data-reveal>
    <h1 class="hero-title">THE MIDNIGHT MECHANICS</h1>
    <p class="hero-subcaption" data-hero-subcaption>Built After Hours</p>
  </div>
  {/* Controls sit in their own corner cluster rather than on top of the photo,
      so they never land over a face or compete with the headline. */}
  <div class="hero-controls">
    <button class="hero-arrow" type="button" data-hero-prev aria-label="Previous photo">
      <span aria-hidden="true">&#8592;</span>
    </button>
    <button class="hero-arrow" type="button" data-hero-next aria-label="Next photo">
      <span aria-hidden="true">&#8594;</span>
    </button>
  </div>
</header>

<script>
  const setupHeroCarousel = () => {
    const slides = Array.from(document.querySelectorAll<HTMLElement>('.hero-slide'));
    const prev = document.querySelector<HTMLButtonElement>('[data-hero-prev]');
    const next = document.querySelector<HTMLButtonElement>('[data-hero-next]');
    if (slides.length < 2) return;

    let current = 0;

    const show = (index: number) => {
      slides[current].classList.remove('is-active');
      slides[current].setAttribute('aria-hidden', 'true');
      slides[index].classList.add('is-active');
      slides[index].removeAttribute('aria-hidden');
      current = index;
    };

    const step = (delta: number) => show((current + delta + slides.length) % slides.length);

    prev?.addEventListener('click', () => step(-1));
    next?.addEventListener('click', () => step(1));
  };

  const setupHeroSubcaption = () => {
    const subcaption = document.querySelector<HTMLElement>('[data-hero-subcaption]');
    if (!subcaption) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
      subcaption.classList.add('is-revealed');
      return;
    }

    const observer = new IntersectionObserver((entries, obs) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        subcaption.classList.add('is-revealed');
        obs.unobserve(entry.target);
      });
    }, { threshold: 0, rootMargin: '0px 0px -35% 0px' });

    observer.observe(subcaption);
    document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
  };

  document.addEventListener('astro:page-load', setupHeroCarousel);
  document.addEventListener('astro:page-load', setupHeroSubcaption);
</script>
