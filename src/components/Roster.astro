---
import { getCollection, type CollectionEntry } from 'astro:content';

const groups = (await getCollection('roster')).sort((a, b) => a.data.order - b.data.order);
---
<div class="roster">
  {groups.map((group: CollectionEntry<'roster'>) => (
    <div class="roster-group" role="group" aria-labelledby={`roster-${group.id}`}>
      <div class="roster-group-head">
        <h3 id={`roster-${group.id}`}>{group.data.group}</h3>
        <span class="roster-count mono">{group.data.members.length}</span>
      </div>
      {group.data.summary && <p class="roster-group-summary">{group.data.summary}</p>}
      <ul class="roster-names">
        {group.data.members.map((member) => (
          <li class:list={['roster-name', { lead: member.lead }]}>
            <span class="roster-member-name">
              <span class:list={{ ph: member.placeholder }}>{member.name}</span>
              {member.lead && <span class="roster-lead-tag">Lead</span>}
            </span>
            {(member.year || member.lead) && (
              <span class="roster-member-detail">{member.year ? `Class of ${member.year}` : 'Subteam lead'}</span>
            )}
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>
