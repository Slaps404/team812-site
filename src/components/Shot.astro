---
import { Image } from 'astro:assets';
import { CONTENT_IMAGE_WIDTHS, SPLIT_IMAGE_SIZES } from '../lib/imageLayout';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  tall?: boolean;
  priority?: boolean;
  sizes?: string;
  style?: string;
}
const {
  src,
  alt,
  caption,
  tall = false,
  priority = false,
  sizes = SPLIT_IMAGE_SIZES,
  style = 'margin:0',
} = Astro.props;
---
<figure class:list={['shot', { tall }]} style={style}>
  <Image
    src={src}
    alt={alt}
    data-gallery-id={src.src}
    widths={CONTENT_IMAGE_WIDTHS}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
  />
  {caption && <figcaption class="mono">{caption}</figcaption>}
</figure>
