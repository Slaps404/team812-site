---
import { getCollection, type CollectionEntry } from 'astro:content';
import qualcomm from '../assets/logos/qualcomm.svg?url';
import nordson from '../assets/logos/nordson.svg?url';
import leidos from '../assets/logos/leidos.svg?url';
import baeSystems from '../assets/logos/bae-systems.svg?url';
import generalAtomics from '../assets/logos/general-atomics-foundation.jpg?url';

const LOGO_SRC: Record<string, string> = { qualcomm, nordson, leidos, 'bae-systems': baeSystems, 'general-atomics': generalAtomics };

const all = await getCollection('sponsors');
const current = all
  .filter((s: CollectionEntry<'sponsors'>) => s.data.tier === 'current')
  .sort((a, b) => a.data.order - b.data.order);
---
<div class="wall">
  {current.map((s: CollectionEntry<'sponsors'>) => (
    <div class:list={['logo', s.data.widthClass]}>
      {s.data.url ? (
        /* The link wraps the logo rather than sitting beside it, so the whole
           cell is the target. The alt text already names the company, so the
           anchor needs no extra label; aria-label would just repeat it. */
        <a href={s.data.url} target="_blank" rel="noopener">
          <img src={LOGO_SRC[s.data.logo ?? '']} alt={s.data.name} />
        </a>
      ) : (
        <img src={LOGO_SRC[s.data.logo ?? '']} alt={s.data.name} />
      )}
    </div>
  ))}
</div>
