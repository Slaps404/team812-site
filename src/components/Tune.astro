---
/* ============================================================
   TUNING PANEL
   Not part of the site. Renders only in dev, or in production when
   the URL carries ?tune. The query string is read client-side so a
   static production build can still support it per-request.
   ============================================================ */
---
<script>
  const shouldRun =
    import.meta.env.DEV || new URLSearchParams(window.location.search).has('tune');

  if (shouldRun) {
    const CONTROLS = [
      {g:'Colour'},
      {v:'--accent',     l:'Accent',        t:'color'},
      {v:'--ground',     l:'Ground',        t:'color'},
      {v:'--ink',        l:'Ink',           t:'color'},
      {v:'--ink-dim',    l:'Dim ink',       t:'color'},
      {v:'--panel',      l:'Sponsor panel', t:'color'},

      {g:'Space'},
      {v:'--space',      l:'Spacing unit',  t:'range', min:.5,  max:2.2, step:.05, u:'rem'},
      {v:'--measure',    l:'Content width', t:'range', min:44,  max:104, step:1,   u:'rem'},

      {g:'Type'},
      {v:'--type-base',  l:'Body size',     t:'range', min:14,  max:22,  step:.5,  u:'px'},
      {v:'--type-scale', l:'Type scale',    t:'range', min:1.10,max:1.50,step:.01, u:''},
      {v:'--display',    l:'Headline size', t:'range', min:3,   max:11,  step:.1,  u:'vw'},

      {g:'Hero crop'},
      {v:'--hero-x',     l:'Pan left/right',t:'range', min:0,   max:100, step:1,   u:'%'},
      {v:'--hero-y',     l:'Pan up/down',   t:'range', min:0,   max:100, step:1,   u:'%'},

      {g:'Form'},
      {v:'--photo-ratio',l:'Photo ratio',   t:'range', min:.65, max:1.9, step:.02, u:''},
      {v:'--radius',     l:'Corner radius', t:'range', min:0,   max:28,  step:1,   u:'px'},

      {g:'Motion'},
      {v:'--motion',     l:'Speed',         t:'range', min:0,   max:600, step:10,  u:'ms'},
    ];

    /* Each entry: [label, css stack, Google Fonts spec or null for a locally
       available face]. Remote experiments load only when explicitly picked. */
    type Face = [string, string, string | null];

    const MONOS: Face[] = [
      ['DM Sans (current)',        "'DM Sans Variable', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Arial, sans-serif", null],
      ['JetBrains Mono',           "'JetBrains Mono', ui-monospace, Menlo, monospace", 'JetBrains+Mono:wght@400;500;600;700'],
      ['IBM Plex Mono',            "'IBM Plex Mono', ui-monospace, Menlo, monospace",  'IBM+Plex+Mono:wght@400;500;600;700'],
      ['Azeret Mono',              "'Azeret Mono', ui-monospace, Menlo, monospace",    'Azeret+Mono:wght@300..700'],
      ['Space Mono',               "'Space Mono', ui-monospace, Menlo, monospace",     'Space+Mono:wght@400;700'],
      ['Martian Mono',             "'Martian Mono', ui-monospace, Menlo, monospace",   'Martian+Mono:wght@300..700'],
      ['Sono (rounded, softest)',  "'Sono', ui-monospace, Menlo, monospace",           'Sono:wght@300..800'],
      ['Spline Sans Mono',         "'Spline Sans Mono', ui-monospace, Menlo, monospace",'Spline+Sans+Mono:wght@300..700'],
      ['Geist Mono',               "'Geist Mono', ui-monospace, Menlo, monospace",     'Geist+Mono:wght@300..700'],
      ['DM Mono',                  "'DM Mono', ui-monospace, Menlo, monospace",        'DM+Mono:wght@300;400;500'],
      ['Reddit Mono',              "'Reddit Mono', ui-monospace, Menlo, monospace",    'Reddit+Mono:wght@300..800'],
      ['Kode Mono',                "'Kode Mono', ui-monospace, Menlo, monospace",      'Kode+Mono:wght@400..700'],
      ['Courier Prime (typewriter)',"'Courier Prime', Courier, monospace",             'Courier+Prime:wght@400;700'],
      ['Fragment Mono',            "'Fragment Mono', ui-monospace, Menlo, monospace",  'Fragment+Mono'],
      ['System mono (no webfont)',  "ui-monospace, 'SF Mono', Menlo, monospace",        null],
    ];

    const SANS: Face[] = [
      ['DM Sans (current)',    "'DM Sans Variable', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Arial, sans-serif", null],
      ['Inter',               "'Inter', -apple-system, BlinkMacSystemFont, Arial, sans-serif", 'Inter:wght@400;500;600;700'],
      ['Geist',                "'Geist', -apple-system, Arial, sans-serif",          'Geist:wght@400;500;600;700'],
      ['Instrument Sans',      "'Instrument Sans', -apple-system, Arial, sans-serif",'Instrument+Sans:wght@400;500;600;700'],
      ['Schibsted Grotesk',    "'Schibsted Grotesk', -apple-system, Arial, sans-serif",'Schibsted+Grotesk:wght@400..700'],
      ['Manrope',              "'Manrope', -apple-system, Arial, sans-serif",        'Manrope:wght@400..700'],
      ['Archivo',              "'Archivo', -apple-system, Arial, sans-serif",        'Archivo:wght@400..700'],
      ['Figtree',              "'Figtree', -apple-system, Arial, sans-serif",        'Figtree:wght@400..700'],
      ['Plus Jakarta Sans',    "'Plus Jakarta Sans', -apple-system, Arial, sans-serif",'Plus+Jakarta+Sans:wght@400..700'],
      ['Public Sans',          "'Public Sans', -apple-system, Arial, sans-serif",    'Public+Sans:wght@400..700'],
      ['System sans (no webfont)', "-apple-system, BlinkMacSystemFont, 'Helvetica Neue', Arial, sans-serif", null],
      ['Georgia (serif, free)', "Georgia, 'Times New Roman', serif",                 null],
    ];

    const loaded = new Set<string>();
    function loadFace(spec: string | null) {
      if (!spec || loaded.has(spec)) return;
      loaded.add(spec);
      const l = document.createElement('link');
      l.rel = 'stylesheet';
      l.href = `https://fonts.googleapis.com/css2?family=${spec}&display=swap`;
      document.head.appendChild(l);
    }

    const root = document.documentElement;
    const num = (s: string) => parseFloat(s);

    const tuneBtn = document.createElement('button');
    tuneBtn.id = 'tuneBtn';
    tuneBtn.textContent = 'Tune';
    document.body.appendChild(tuneBtn);

    const panel = document.createElement('aside');
    panel.id = 'tune';
    document.body.appendChild(panel);

    function build() {
      let h = '';
      CONTROLS.forEach(c => {
        if ('g' in c) { h += `<h4>${c.g}</h4>`; return; }
        const cur = getComputedStyle(root).getPropertyValue(c.v!).trim();
        if (c.t === 'color') {
          h += `<div class="row"><div class="lab"><span>${c.l}</span><i>${cur}</i></div>
                <input type="color" data-v="${c.v}" value="${cur}"></div>`;
        } else {
          h += `<div class="row"><div class="lab"><span>${c.l}</span><i>${cur}</i></div>
                <input type="range" data-v="${c.v}" data-u="${c.u}"
                  min="${c.min}" max="${c.max}" step="${c.step}" value="${num(cur)}"></div>`;
        }
      });

      h += `<h4>Typefaces</h4>
            <div class="row"><div class="lab"><span>Mono (labels, nav, numbers)</span></div>
            <select id="monoSel">${MONOS.map((f, i) => `<option value="${i}">${f[0]}</option>`).join('')}</select></div>
            <div class="row"><div class="lab"><span>Mono weight</span><i>${getComputedStyle(root).getPropertyValue('--mono-weight').trim()}</i></div>
            <input type="range" data-v="--mono-weight" min="300" max="700" step="100"
              value="${num(getComputedStyle(root).getPropertyValue('--mono-weight'))}"></div>
            <label class="tog"><input type="checkbox" id="chromeTog"> Mono on nav, buttons and labels (the all-mono look)</label>
            <div class="row"><div class="lab"><span>Sans (headlines, body)</span></div>
            <select id="sansSel">${SANS.map((f, i) => `<option value="${i}">${f[0]}</option>`).join('')}</select></div>`;

      h += `<h4>Review</h4>
            <label class="tog"><input type="checkbox" id="flagTog" checked> Highlight unconfirmed data</label>
            <label class="tog"><input type="checkbox" id="gridTog"> Show layout rhythm</label>
            <div class="note" id="flagCount"></div>

            <h4>Export</h4>
            <button class="go" id="dl">Download tokens.css</button>
            <button id="reset">Reset to defaults</button>
            <div class="note">Drag until you like it, then download. Hand me the file and I bake the values in. You never open an editor.<br><br>Press <b>T</b> to hide this panel. It is deleted from the real site.</div>`;

      panel.innerHTML = h;

      panel.addEventListener('input', e => {
        const i = e.target as HTMLInputElement;
        if (!i.dataset.v) return;
        const val = i.type === 'color' ? i.value : i.value + (i.dataset.u || '');
        root.style.setProperty(i.dataset.v, val);
        i.closest('.row')!.querySelector('i')!.textContent = val;
        save();
      });

      const pick = (sel: string, list: Face[], token: string) =>
        panel.querySelector<HTMLSelectElement>(sel)!.addEventListener('change', e => {
          const [, stack, spec] = list[+(e.target as HTMLSelectElement).value];
          loadFace(spec);
          root.style.setProperty(token, stack);
          save();
        });
      pick('#monoSel', MONOS, '--font-mono');
      pick('#sansSel', SANS, '--font-sans');

      /* A reload restores the saved stack, but the webfont is not loaded yet and
         the dropdown would read as entry 0. Match the stack back to its entry. */
      const sync = (sel: string, list: Face[], token: string) => {
        const cur = getComputedStyle(root).getPropertyValue(token).trim();
        const i = list.findIndex(f => f[1] === cur);
        if (i < 0) return;
        loadFace(list[i][2]);
        panel.querySelector<HTMLSelectElement>(sel)!.value = String(i);
      };
      sync('#monoSel', MONOS, '--font-mono');
      sync('#sansSel', SANS, '--font-sans');

      const chromeTog = panel.querySelector<HTMLInputElement>('#chromeTog')!;
      chromeTog.checked = getComputedStyle(root).getPropertyValue('--font-chrome').trim()
                          === getComputedStyle(root).getPropertyValue('--font-mono').trim();
      chromeTog.addEventListener('change', e => {
        const on = (e.target as HTMLInputElement).checked;
        root.style.setProperty('--font-chrome', on ? 'var(--font-mono)' : 'var(--font-sans)');
        root.style.setProperty('--chrome-track', on ? '.11em' : '.07em');
        save();
      });

      panel.querySelector<HTMLInputElement>('#flagTog')!.addEventListener('change', e =>
        document.body.classList.toggle('flags', (e.target as HTMLInputElement).checked));

      panel.querySelector<HTMLInputElement>('#gridTog')!.addEventListener('change', e =>
        (document.body.style.backgroundImage = (e.target as HTMLInputElement).checked
          ? 'repeating-linear-gradient(to bottom, rgba(33,199,193,.11) 0 1px, transparent 1px var(--space))'
          : 'none'));

      const n = document.querySelectorAll('.ph').length;
      panel.querySelector('#flagCount')!.innerHTML =
        `<b style="color:#e8a33d">${n} items still need real data.</b> Do not publish while any flag is visible.`;

      panel.querySelector('#dl')!.addEventListener('click', download);
      panel.querySelector('#reset')!.addEventListener('click', () => {
        root.removeAttribute('style');
        localStorage.removeItem('t812');
        build();
      });
    }

    /* Writes the token block as a real CSS file. This is the handoff. */
    function download() {
      const cs = getComputedStyle(root);
      let out = '/* Team 812 design tokens. Generated from the tuning panel. */\n:root{\n';
      CONTROLS.filter(c => c.v).forEach(c =>
        out += `  ${c.v}: ${cs.getPropertyValue(c.v!).trim()};\n`);
      out += `  --font-sans: ${cs.getPropertyValue('--font-sans').trim()};\n`;
      out += `  --font-mono: ${cs.getPropertyValue('--font-mono').trim()};\n`;
      out += `  --mono-weight: ${cs.getPropertyValue('--mono-weight').trim()};\n`;
      out += `  --font-chrome: ${(root.style.getPropertyValue('--font-chrome') || 'var(--font-sans)').trim()};\n`;
      out += `  --chrome-track: ${cs.getPropertyValue('--chrome-track').trim()};\n}\n`;
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([out], { type: 'text/css' }));
      a.download = 'tokens.css';
      a.click();
      URL.revokeObjectURL(a.href);
    }

    /* Your drags survive a page reload. */
    function save() { localStorage.setItem('t812', root.getAttribute('style') || ''); }
    const saved = localStorage.getItem('t812');
    if (saved) root.setAttribute('style', saved);

    build();

    const toggle = () => panel.classList.toggle('open');
    tuneBtn.addEventListener('click', toggle);
    document.addEventListener('keydown', e => {
      if (e.key.toLowerCase() === 't' && !/input|select|textarea/i.test((e.target as HTMLElement).tagName)) toggle();
    });
  }
</script>
