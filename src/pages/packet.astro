---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Packet from '../layouts/Packet.astro';

import coverImg from '../assets/photos/2026-states-robot-team.jpg';
import preussImg from '../assets/photos/2026-states-IMG_0935.jpg';
import robotImg from '../assets/photos/big-jiawei-hero.jpg';
import badge from '../assets/logos/team812-badge.png';
import qualcomm from '../assets/logos/qualcomm.svg?url';
import nordson from '../assets/logos/nordson.svg?url';
import leidos from '../assets/logos/leidos.svg?url';
import generalAtomics from '../assets/logos/general-atomics-foundation.jpg?url';

const packet = (await getCollection('packet'))[0].data;
const stats = (await getCollection('stats')).sort((a, b) => a.data.order - b.data.order);
const funds = (await getCollection('funds')).sort((a, b) => a.data.order - b.data.order);
const tiers = (await getCollection('tiers')).sort((a, b) => a.data.order - b.data.order);
const reasons = (await getCollection('reasons')).sort((a, b) => a.data.order - b.data.order);
const mentors = (await getCollection('mentors'))
  .sort((a, b) => a.data.order - b.data.order);
const sponsors = (await getCollection('sponsors'))
  .filter((s) => s.data.tier === 'current')
  .sort((a, b) => a.data.order - b.data.order);

const logoSrc: Record<string, string> = { qualcomm, nordson, leidos, 'general-atomics': generalAtomics };

function plain(html: string) {
  return html.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
}

const siteHost = new URL(packet.site).host.replace(/^www\./, '');
---
<Packet
  title="2027 Sponsorship Packet | The Midnight Mechanics"
  description={packet.description}
>

<p class="packet-screen">
  Local print source. Edit <kbd>src/data/packet.yaml</kbd>, then run <kbd>npm run packet</kbd>.
</p>

<article class="sheet sheet-cover" aria-label="Cover">
  <div class="cover-media">
    <Image
      src={coverImg}
      alt="Team 812 students and mentors with the competition robot at a district event."
      widths={[2000]}
      sizes="8.5in"
    />
  </div>
  <div class="cover-scrim" aria-hidden="true"></div>
  <div class="cover-top">
    <Image src={badge} alt="" class="cover-badge" widths={[220]} sizes="0.72in" />
    <p class="cover-meta">{packet.school}<br />{packet.location}</p>
  </div>
  <div class="cover-bottom">
    <p class="cover-number">{packet.number}</p>
    <h1 class="cover-name">{packet.team}</h1>
    <div class="cover-rule" aria-hidden="true"></div>
    <p class="cover-season">{packet.cover_season}</p>
  </div>
</article>

<article class="sheet sheet-who" aria-label="Who we are">
  <div class="sheet-pad">
    <header class="page-head">
      <p class="team">{packet.team}</p>
      <p class="num">{packet.number}</p>
    </header>

    <div class="split">
      <div>
        <p class="kicker">{packet.kicker}</p>
        <h1>{packet.about_headline}</h1>
        <p class="lede">{packet.pitch}</p>
        <p class="lede">{packet.shortfall}</p>
        <p class="lede">{packet.about_body}</p>
      </div>
      <figure class="photo tall">
        <Image
          src={preussImg}
          alt="Team 812 members at The Preuss School UC San Diego."
          widths={[1200]}
          sizes="3.4in"
        />
        <figcaption>The Preuss School UC San Diego</figcaption>
      </figure>
    </div>

    <div class="stat-row">
      {stats.map((s) => (
        <div class="stat">
          <div class="stat-value">{s.data.value}{s.data.suffix}</div>
          <div class="stat-label">{s.data.label}</div>
        </div>
      ))}
    </div>

    <p class="note" style="margin:0 0 0.18in">
      {packet.extra_stats.map((s) => `${s.value} ${s.label.charAt(0).toLowerCase()}${s.label.slice(1)}`).join(' · ')}
    </p>

    <h2>Mentors</h2>
    <div class="mentors">
      {mentors.map((m) => (
        <div class="mentor">
          <p class="mentor-name">{m.data.name}</p>
          <p class="mentor-role">{m.data.role}{m.data.honor ? ` · ${m.data.honor.replace(' — ', ', ')}` : ''}</p>
          <p class="mentor-known">{m.data.knownFor.join(' · ')}</p>
        </div>
      ))}
    </div>

    <footer class="page-foot">
      <span>{packet.email}</span>
      <span>2 / 4</span>
    </footer>
  </div>
</article>

<article class="sheet" aria-label="Season and FIRST">
  <div class="sheet-pad">
    <header class="page-head">
      <p class="team">{packet.season_year} season</p>
      <p class="num">{packet.robot}</p>
    </header>

    <div class="season-grid">
      <div class="robot-frame">
        <Image
          src={robotImg}
          alt={`${packet.robot}, Team 812's ${packet.season_year} ${packet.game} robot.`}
          widths={[1200]}
          sizes="3.4in"
        />
      </div>
      <div>
        <p class="kicker">{packet.game} · official record</p>
        <p class="record">{packet.record}</p>
        <p class="lede">{packet.season_body}</p>
        <ul class="events">
          {packet.season_events.map((evt) => (
            <li>
              <span>{evt.label}</span>
              <span class="result">{evt.result}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <h2 style="margin-top:0.26in">{packet.first_headline}</h2>
    <p class="lede">{packet.first_body}</p>
    <ul class="points">
      {packet.first_points.map((pt) => <li>{pt}</li>)}
    </ul>

    <h2 style="margin-top:0.22in">Why 812</h2>
    <div class="reasons">
      {reasons.map((r) => (
        <div class="reason">
          <h3>{r.data.title}</h3>
          <p>{plain(r.data.body)}</p>
        </div>
      ))}
    </div>

    <div class="awards">
      {packet.awards.map((a) => (
        <div class="award">
          <p class="award-year">{a.year}</p>
          <p class="award-name">{a.name}</p>
        </div>
      ))}
    </div>

    <footer class="page-foot">
      <span>16 seasons of robot code on GitHub · preuss812</span>
      <span>3 / 4</span>
    </footer>
  </div>
</article>

<article class="sheet sheet-give" aria-label="How to give">
  <div class="sheet-pad">
    <header class="page-head">
      <p class="team">Our 2027 funding gap</p>
      <p class="num">$10,000</p>
    </header>

    <div class="ask-band">
      <div>
        <p class="kicker">Working estimate</p>
        <p class="lede" style="max-width:5.6in">{packet.ask}</p>
      </div>
    </div>

    <div class="split">
      <div>
        <h2>How we’ll use your support</h2>
        <div class="funds">
          {funds.map((f) => (
            <div class:list={['fund', { total: f.data.total }]}>
              <span>{f.data.label}</span>
              <span>{f.data.amount}</span>
            </div>
          ))}
        </div>

      </div>
      <div>
        <h2>{packet.give_headline}</h2>
        <p class="lede">{packet.give_body}</p>
        <p class="ein">{packet.legal_name}, EIN {packet.ein}.</p>
        <p class="note">{packet.invoice_note}</p>
        <p class="note">{packet.inkind_note}</p>
      </div>
    </div>

    <h2 style="margin-top:0.24in">Sponsor tiers</h2>
    <p class="note">{packet.stacking_note}</p>
    <div class="tiers">
      {tiers.map((t) => (
        <div class:list={['tier', { top: t.data.top }]}>
          <p class="tier-name">{t.data.name}</p>
          <p class="tier-amt">{t.data.amount}</p>
          {t.data.precede && <p class="tier-precede">{t.data.precede}</p>}
          <ul>
            {t.data.items.map((item) => <li set:html={item.replace("this site’s homepage", "our website’s homepage").replace("this site's homepage", "our website's homepage")} />)}
          </ul>
        </div>
      ))}
    </div>

    <h2 style="margin-top:0.22in">Current sponsors</h2>
    <div class="logos">
      {sponsors.map((s) => (
        s.data.logo && logoSrc[s.data.logo] ? (
          <img class:list={{ 'foundation-logo': s.data.logo === 'general-atomics' }} src={logoSrc[s.data.logo]} alt={s.data.name} />
        ) : (
          <span>{s.data.name}</span>
        )
      ))}
    </div>

    <div class="contact-row">
      <div class="contact-item">
        <p class="label">Email</p>
        <p class="value">{packet.email}</p>
      </div>
      <div class="contact-item">
        <p class="label">Site</p>
        <p class="value">{siteHost}</p>
      </div>
      <div class="contact-item">
        <p class="label">Instagram</p>
        <p class="value">@{packet.instagram}</p>
      </div>
    </div>

    <footer class="page-foot">
      <span>What time is it? Midnight.</span>
      <span>4 / 4</span>
    </footer>
  </div>
</article>

</Packet>
