---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Shot from '../components/Shot.astro';
import { robotSeasons, getAwardDescription } from '../data/robots';

import robotPitImg from '../assets/photos/team-812-robot-pit.png';
---
<Base
  title="Robots | The Midnight Mechanics"
  description="A year-by-year archive of Team 812 competition robots and the code behind them."
>

<Nav current="robots" />

<main class="view on" id="v-robots">
  <section class="archive-hero" data-reveal>
    <div class="wrap split feature-split">
      <div>
        <h1>Every robot we've built.</h1>
        <p class="body archive-lede">An archive of our competition robots, match results, and code repositories dating back to 2011.</p>
        <a class="btn ghost" href="#robot-seasons">View all seasons</a>
      </div>
      <Shot
        src={robotPitImg}
        alt="A Team 812 student and mentor working on the robot in the pit at the 2026 state championship."
        caption="Pit crew tuning at the FIRST California Southern State Championship"
        priority
      />
    </div>
  </section>

  <section data-reveal>
    <div class="wrap">
      <p class="mono eyebrow">FEATURED RECORD</p>
      <div class="robot-feature">
        <div>
          <p class="robot-year">2026 <span>/ {robotSeasons[0].game}</span></p>
          <h2>The current machine, under pressure.</h2>
          <p class="body">{robotSeasons[0].description}</p>
          <a class="btn solid" href={robotSeasons[0].repoUrl} target="_blank" rel="noopener">Read the 2026 code</a>
        </div>
        <div class="robot-facts" aria-label="2026 robot record status">
          <p class="label">Record status</p>
          <p class="robot-fact-value">Photo documented</p>
          <p class="label">Next additions</p>
          <p class="robot-fact-value">Robot name, specs, and build notes</p>
        </div>
      </div>
    </div>
  </section>

  <hr class="rule">

  <section id="robot-seasons" data-reveal>
    <div class="wrap">
      <div class="section-heading">
        <div>
          <p class="mono eyebrow">SEASON ARCHIVE</p>
          <h2>All of our robots.</h2>
        </div>
        <p class="body">16 seasons of competition history, public code repositories, and recorded match data.</p>
      </div>
      <div class="robot-archive" role="list">
        {robotSeasons.map((robot) => (
          <article class="robot-row-card" role="listitem">
            <p class="robot-row-year">{robot.year}</p>
            <div class="robot-row-copy">
              <div class="robot-row-header">
                <h3>
                  <a class="robot-row-title-link" href={`/robots/${robot.year}`} aria-label={`View the ${robot.year} ${robot.game} season record`}>
                    {robot.game}
                  </a>
                </h3>
                <span class="robot-row-arrow" aria-hidden="true">→</span>
              </div>
              <p class="body">{robot.description}</p>
              {robot.awards && robot.awards.length > 0 && (
                <div class="robot-awards">
                  {robot.awards.map((award) => {
                    const l = award.toLowerCase();
                    const isMajor = l.includes('chairman') || l.includes('winner') || l.includes('inspiration') || l.includes('flowers') || l.includes('dean');
                    const desc = getAwardDescription(award);
                    return (
                      <span class:list={['robot-award-tag', { major: isMajor }]} tabindex="0">
                        {isMajor ? `★ ${award}` : award}
                        <span class="award-tooltip" role="tooltip">{desc}</span>
                      </span>
                    );
                  })}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</main>

<Footer />

</Base>
