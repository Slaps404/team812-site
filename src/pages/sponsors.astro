---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Split from '../components/Split.astro';
import Shot from '../components/Shot.astro';
import Reasons from '../components/Reasons.astro';
import Tiers from '../components/Tiers.astro';
import Funds from '../components/Funds.astro';
import LogoWall from '../components/LogoWall.astro';
import Tune from '../components/Tune.astro';

import rosterImg from '../assets/photos/2026-states-IMG_1011.jpg';

const donationUrl = 'https://giveto.ucsd.edu/giving/home/?linkId=98e77c65-0221-4291-b0c9-029538948e1c';
---
<Base
  title="Sponsor FRC Team 812 | The Midnight Mechanics"
  description="Learn about sponsoring The Midnight Mechanics for the 2027 FRC season at The Preuss School UC San Diego."
>

<Nav current="sponsors" />

<main class="view on" id="v-sponsors">

  <section class="sponsor-hero" data-reveal style="padding-top:calc(var(--space) * 3.5)">
    <Split class="sponsor-hero-split" style="align-items:center">
      <Fragment slot="left">
        <h1 style="font-size:var(--t4);max-width:22em">Support the students building Team 812's next robot.</h1>
        <p class="body" style="font-size:var(--t1);margin-top:calc(var(--space) * 1.4)">We need <b style="color:var(--accent)"><a href="#funding-breakdown" style="color:inherit">$10,000</a></b> for the 2027 season. Here is exactly what you get, and exactly where the money goes.</p>
        <button class="btn solid sponsor-primary" type="button" id="open-sponsor-modal">Donate to Team 812</button>
      </Fragment>
      <Fragment slot="right">
        <Shot src={rosterImg} alt="The 2026 Team 812 roster in team shirts." caption="The people you would be funding / 2026" priority />
      </Fragment>
    </Split>
  </section>

  <section data-reveal style="padding-top:0">
    <div class="wrap">
      <h2>Why Team 812</h2>
      <Reasons />
    </div>
  </section>

  <section data-reveal style="padding-top:0">
    <div class="wrap">
      <h2>What each level gets.</h2>
      <Tiers />
      <p class="body" style="max-width:none;margin-top:calc(var(--space) * 2);opacity:.62;font-size:var(--t-1)">Tiers stack, so a $5,000 sponsor gets all ten items. Under $1,000, we list your name on this page as a Supporter. Every benefit here is something the team controls directly, so we can actually deliver it.</p>
    </div>
  </section>

  <hr class="rule">

  <section id="funding-breakdown" data-reveal>
    <Split>
      <Fragment slot="left">
        <h2 class="label">Where it goes</h2>
        <Funds compact />
        <p class="flag-note">Rough estimate, not final</p>
      </Fragment>
      <Fragment slot="right">
        <h2 class="label">How to give</h2>
        <p class="body"><b>Sponsorships and donations go to the Preuss School Robotics gift fund.</b></p>
        <p class="body">Corporate sponsors: email us for an invoice and a W-9.</p>
        <p class="body">Contact: <b><a href="mailto:team812@preuss.ucsd.edu">team812@preuss.ucsd.edu</a></b></p>
      </Fragment>
    </Split>
  </section>

  <div class="panel" data-reveal>
    <div class="wrap">
      <h2 class="label">Current sponsors</h2>
      <LogoWall />
    </div>
  </div>

</main>

<dialog class="sponsor-modal" id="sponsor-modal" aria-labelledby="sponsor-modal-title">
  <div class="sponsor-modal-inner">
    <button class="modal-close" type="button" id="close-sponsor-modal" aria-label="Close donation instructions">×</button>
    <p class="mono">Quick donation guide</p>
    <h2 id="sponsor-modal-title">Send your gift to Team 812</h2>
    <p class="body">The UCSD form has several funds. Follow these steps so your donation reaches the Preuss School Robotics Team.</p>
    <ol class="sponsor-steps">
      <li><b>Open the UCSD giving form.</b><span>Click the button below.</span></li>
      <li><b>Search for “robotics team”.</b><span>Use the fund search box on the giving page.</span></li>
      <li><b>Select “Preuss School Robotics Team”.</b><span>That is the fund that sends your gift to Team 812.</span></li>
    </ol>
    <a class="btn solid modal-donate" href={donationUrl} target="_blank" rel="noopener noreferrer">Open UCSD Giving</a>
    <p class="modal-note">The giving form opens in a new tab, so you can keep these instructions handy.</p>
  </div>
</dialog>

<script>
  const modal = document.querySelector<HTMLDialogElement>('#sponsor-modal');
  const openButton = document.querySelector<HTMLButtonElement>('#open-sponsor-modal');
  const closeButton = document.querySelector<HTMLButtonElement>('#close-sponsor-modal');

  openButton?.addEventListener('click', () => modal?.showModal());
  closeButton?.addEventListener('click', () => modal?.close());
  modal?.addEventListener('click', (event) => {
    if (event.target === modal) modal.close();
  });
</script>

<Footer />

<Tune />

</Base>
