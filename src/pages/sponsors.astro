---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Split from '../components/Split.astro';
import Shot from '../components/Shot.astro';
import Reasons from '../components/Reasons.astro';
import Tiers from '../components/Tiers.astro';
import Funds from '../components/Funds.astro';
import LogoWall from '../components/LogoWall.astro';
import Tune from '../components/Tune.astro';

import rosterImg from '../assets/photos/2026-states-IMG_1011.jpg';

const sponsors = await getCollection('sponsors');
const past = sponsors.find((s: CollectionEntry<'sponsors'>) => s.data.tier === 'past');
const supporter = sponsors.find((s: CollectionEntry<'sponsors'>) => s.data.tier === 'supporter');
---
<Base
  title="Sponsor FRC Team 812 | The Midnight Mechanics"
  description="Sponsor The Midnight Mechanics for the 2027 FRC season and see how Team 812 uses every contribution."
>

<Nav current="sponsors" />

<main class="view on" id="v-sponsors">

  <section style="padding-top:calc(var(--space) * 3.5)">
    <Split style="align-items:end">
      <Fragment slot="left">
        <h1 style="font-size:var(--t4);max-width:22em">Put your name on a robot built by students who need it most.</h1>
        <p class="body" style="font-size:var(--t1);margin-top:calc(var(--space) * 1.4)">We need <b style="color:var(--accent)">$10,000</b> for the 2027 season. Here is exactly what you get, and exactly where the money goes.</p>
      </Fragment>
      <Fragment slot="right">
        <Shot src={rosterImg} alt="The 2026 Team 812 roster in team shirts." caption="The people you would be funding / 2026" priority />
      </Fragment>
    </Split>
  </section>

  <section style="padding-top:0">
    <div class="wrap">
      <h2 class="label">Why team 812</h2>
      <Reasons />
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap">
      <h2>What each level gets.</h2>
      <Tiers />
      <p class="body" style="margin-top:calc(var(--space) * 2);opacity:.62;font-size:var(--t-1)">Tiers stack, so a $5,000 sponsor gets all ten items. Under $1,000, we list your name on this page as a Supporter. Every benefit here is something the team controls directly, so we can actually deliver it.</p>
    </div>
  </section>

  <hr class="rule">

  <section>
    <Split>
      <Fragment slot="left">
        <h2 class="label">Where it goes</h2>
        <Funds />
      </Fragment>
      <Fragment slot="right">
        <h2 class="label">How to give</h2>
        <p class="body">Team 812's money sits in a robotics account held by The Preuss School UC San Diego. The account has a class fund and a gift fund. <b>Sponsorship and donations go to the gift fund.</b></p>
        <p class="body">Corporate sponsors: email us and we will send an invoice and a W-9.</p>
        <p class="body">Contact: <b><a href="mailto:team812@preuss.ucsd.edu">team812@preuss.ucsd.edu</a></b></p>
        <div class="cta" style="display:flex;gap:calc(var(--space) * .7);margin-top:calc(var(--space) * 1.6)">
          <a class="btn solid ph" href="#">Give to the gift fund<span class="ph-tag">need link</span></a>
        </div>
      </Fragment>
    </Split>
  </section>

  <div class="panel">
    <div class="wrap">
      <h2 class="label">Current sponsors</h2>
      <LogoWall />
      <h2 class="label" style="margin-top:calc(var(--space) * 2.6)">Past support</h2>
      <p style="color:color-mix(in srgb, var(--panel-ink) 70%, transparent);max-width:36em">{past?.data.name}</p>
      <h2 class="label" style="margin-top:calc(var(--space) * 2.6)">Supporters</h2>
      <p class="ph" style="color:color-mix(in srgb, var(--panel-ink) 70%, transparent);max-width:36em">{supporter?.data.name}<span class="ph-tag">{supporter?.data.tag}</span></p>
    </div>
  </div>

</main>

<Footer />

<Tune />

</Base>
