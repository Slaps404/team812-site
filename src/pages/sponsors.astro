---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Split from '../components/Split.astro';
import Shot from '../components/Shot.astro';
import Reasons from '../components/Reasons.astro';
import Tiers from '../components/Tiers.astro';
import Funds from '../components/Funds.astro';
import LogoWall from '../components/LogoWall.astro';

import rosterImg from '../assets/photos/2026-states-IMG_1011.jpg';

const donationUrl = 'https://giveto.ucsd.edu/giving/home/?linkId=f84b6f44-4eb5-43e6-9468-5e756a2d4696';
---
<Base
  title="Sponsor FRC Team 812 | The Midnight Mechanics"
  description="Learn about sponsoring The Midnight Mechanics for the 2027 FRC season at The Preuss School UC San Diego."
>

<Nav current="sponsors" />

<main class="view on" id="v-sponsors">

  <section class="sponsor-hero" data-reveal>
    <Split class="sponsor-hero-split" style="align-items:center">
      <Fragment slot="left">
        <h1 style="font-size:var(--t4);max-width:22em">Support the students building Team 812's next robot.</h1>
        <p class="body" style="font-size:var(--t1);margin-top:calc(var(--space) * 1.4)">We need <b style="color:var(--accent)"><a href="#funding-breakdown" style="color:inherit">$10,000</a></b> for the 2027 season. Here is exactly what you get, and exactly where the money goes.</p>
        <a class="btn solid sponsor-primary" href={donationUrl} target="_blank" rel="noopener noreferrer">Donate to Team 812</a>
      </Fragment>
      <Fragment slot="right">
        <Shot src={rosterImg} alt="The 2026 Team 812 roster in team shirts." caption="The students and mentors you support on Team 812" priority />
      </Fragment>
    </Split>
  </section>

  <section data-reveal style="padding-top:0">
    <div class="wrap">
      <h2>Why Team 812</h2>
      <Reasons />
    </div>
  </section>

  <section id="tiers" data-reveal style="padding-top:0;scroll-margin-top:5rem">
    <div class="wrap">
      <h2>Sponsor tiers</h2>
      <Tiers />
        <p class="body" style="max-width:none;margin-top:calc(var(--space) * 2);opacity:.62;font-size:var(--t-1)">Tiers stack, so a $5,000 sponsor gets all ten items. Under $1,000, we list your name on this page as a Supporter.</p>
    </div>
  </section>

  <hr class="rule">

  <section id="funding-breakdown" data-reveal>
    <div class="wrap">
      <div class="funding-ask">
        <h2 class="label">The 2027 ask</h2>
        <div class="funding-ask-amount">$10,000</div>
      </div>
    </div>
    <Split>
      <Fragment slot="left">
        <h2 class="label">Where it goes</h2>
        <Funds compact chart={false} />
      </Fragment>
      <Fragment slot="right">
        <h2 class="label">How to give</h2>
        <p class="body">Contact <b><a href="mailto:team812@preuss.ucsd.edu">team812@preuss.ucsd.edu</a></b></p>
        <p class="body">Corporate sponsors: email us for an invoice and a W-9.</p>
      </Fragment>
    </Split>
  </section>

  <div class="panel" data-reveal>
    <div class="wrap">
      <h2 class="label">Sponsors</h2>
      <LogoWall />
    </div>
  </div>

</main>

<Footer />

</Base>
