---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const email = 'team812@preuss.ucsd.edu';

const contactTopics = [
  'Sponsorship information',
  'In-kind donation',
  'Partnership or outreach',
  'Team 812 question',
  'Other',
];
---
<Base
  title="Contact | The Midnight Mechanics"
  description="Contact FRC Team 812 at The Preuss School UC San Diego about sponsorships, in-kind donations, partnerships, or other team questions."
>

<Nav current="contact" />

<main class="view on" id="v-contact">
  <section class="contact-page">
    <div class="wrap contact-page-layout">
      <div class="contact-page-intro">
        <h1>Want to reach out?</h1>
        <p class="body team-lede">Please leave a message below.</p>
        <p class="body contact-hero-copy">Interested in sponsoring Team 812 or supporting the team with a donation, service, or partnership? Tell us a little about yourself and how we can help. Prefer to draft it yourself? <a class="contact-email-link" href={`mailto:${email}`}>{email}</a></p>
      </div>

      <form
        class="contact-form"
        id="contact-form"
        action={`https://formsubmit.co/${email}`}
        method="POST"
      >
        <input type="hidden" name="_subject" value="New Team 812 contact form submission">
        <input type="hidden" name="_template" value="table">
        <input class="contact-honey" type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true">

        <div class="contact-form-grid">
          <div class="contact-field">
            <label for="contact-name">Your name <span aria-hidden="true">*</span></label>
            <input id="contact-name" name="name" type="text" autocomplete="name" required>
          </div>

          <div class="contact-field">
            <label for="contact-email">Email <span aria-hidden="true">*</span></label>
            <input id="contact-email" name="email" type="email" autocomplete="email" required>
          </div>

          <div class="contact-field">
            <label for="contact-organization">Company or organization</label>
            <input id="contact-organization" name="organization" type="text" autocomplete="organization">
          </div>

          <div class="contact-field">
            <label for="contact-topic">I am interested in <span aria-hidden="true">*</span></label>
            <select id="contact-topic" name="topic" required>
              <option value="" selected disabled>Select one</option>
              {contactTopics.map((topic) => <option value={topic}>{topic}</option>)}
            </select>
          </div>

          <div class="contact-field contact-field-full">
            <label for="contact-message">Message <span aria-hidden="true">*</span></label>
            <textarea id="contact-message" name="message" rows="7" required placeholder="Tell us what you would like to discuss, including the kind of support you have in mind."></textarea>
          </div>
        </div>

        <div class="contact-form-action">
          <button class="btn solid" type="submit">Submit</button>
        </div>
      </form>
    </div>
  </section>

</main>

<Footer />

</Base>
