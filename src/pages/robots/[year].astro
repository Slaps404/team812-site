---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Album, { type PhotoItem } from '../../components/Album.astro';
import { robotSeasons, type RobotSeason, getAwardDescription } from '../../data/robots';

import pit from '../../assets/photos/team-812-robot-pit.png';
import states1026 from '../../assets/photos/2026-states-IMG_1026.jpg';
import states1033 from '../../assets/photos/2026-states-IMG_1033.jpg';
import states1045 from '../../assets/photos/2026-states-IMG_1045.jpg';
import tbaFavicon from '../../assets/logos/tba-favicon.ico';
import githubFavicon from '../../assets/logos/github-favicon.svg';

export function getStaticPaths() {
  return robotSeasons.map((robot) => ({
    params: { year: String(robot.year) },
    props: { robot },
  }));
}

const { robot } = Astro.props as { robot: RobotSeason };

// Photos album registry by year (add any season photos here)
const seasonAlbums: Record<number, PhotoItem[]> = {
  2026: [
    {
      src: pit,
      alt: 'Team 812 students and mentor tuning the robot in the pit at the state championship.',
      caption: 'Pit crew tuning at the FIRST California Southern State Championship',
    },
    {
      src: states1026,
      alt: "A mentor and students working on Team 812's shooter mechanism.",
      caption: 'Shooter mechanism calibration between matches',
    },
    {
      src: states1033,
      alt: 'Students and mentor repairing the drivetrain in the pit.',
      caption: 'Drivetrain repair in the pits before queueing',
    },
    {
      src: states1045,
      alt: 'Team 812 members and robot at the 2026 state championship.',
      caption: 'Team 812 pit crew at the State Championship',
    },
  ],
  // 2025: [ ... ] - easily add your 2025 photos here!
};

const photos = seasonAlbums[robot.year] ?? [];
---
<Base
  title={`${robot.year} Robot | The Midnight Mechanics`}
  description={`${robot.year} Team 812 robot record, public code, and season notes.`}
>

<Nav current="robots" />

<main class="view on" id="v-robot-detail">
  <section class="robot-detail-hero" data-reveal>
    <div class="wrap">
      <a class="back-link mono" href="/robots">← Robot archive</a>
      <p class="mono eyebrow">SEASON RECORD / {robot.year}</p>
      <h1>{robot.game ? `The ${robot.game} robot.` : `The ${robot.year} robot record.`}</h1>
      <p class="body archive-lede">{robot.description}</p>
    </div>
  </section>

  <section data-reveal>
    <div class="wrap robot-detail-grid">
      <Album photos={photos} year={robot.year} />
      <div class="robot-detail-facts">
        <p class="label">Game theme</p>
        <p class="robot-fact-value">{robot.game}</p>

        {robot.events && robot.events.length > 0 && (
          <div>
            <p class="label">Competitions & Events</p>
            <ul style="margin:0 0 calc(var(--space) * 1.4);padding-left:1.2rem;font-size:var(--t-1);color:var(--ink-dim);line-height:1.6">
              {robot.events.map((evt) => <li>{evt}</li>)}
            </ul>
          </div>
        )}

        {robot.awards && robot.awards.length > 0 && (
          <div>
            <p class="label">Awards & Honors</p>
            <div class="robot-awards" style="margin-bottom:calc(var(--space) * 1.4)">
              {robot.awards.map((award) => {
                const l = award.toLowerCase();
                const isMajor = l.includes('chairman') || l.includes('winner') || l.includes('inspiration') || l.includes('flowers') || l.includes('dean');
                const desc = getAwardDescription(award);
                return (
                  <span class:list={['robot-award-tag', { major: isMajor }]} tabindex="0">
                    {isMajor ? `★ ${award}` : award}
                    <span class="award-tooltip" role="tooltip">{desc}</span>
                  </span>
                );
              })}
            </div>
          </div>
        )}

        <p class="label">External records & code</p>
        <div style="display:flex;flex-direction:column;gap:calc(var(--space) * .6);margin-top:calc(var(--space) * .3)">
          <a class="robot-ext-btn" href={`https://www.thebluealliance.com/team/812/${robot.year}`} target="_blank" rel="noopener noreferrer">
            <div class="robot-ext-left">
              <img src={tbaFavicon.src} alt="" class="robot-ext-icon" width="20" height="20" />
              <span>View {robot.year} on The Blue Alliance</span>
            </div>
            <span class="robot-ext-arrow" aria-hidden="true">↗</span>
          </a>
          <a class="robot-ext-btn" href={robot.repoUrl} target="_blank" rel="noopener noreferrer">
            <div class="robot-ext-left">
              <img src={githubFavicon.src} alt="" class="robot-ext-icon" width="20" height="20" />
              <span>Open {robot.year} GitHub code</span>
            </div>
            <span class="robot-ext-arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <hr class="rule">

  <section data-reveal>
    <div class="wrap" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:calc(var(--space) * 1.5)">
      <div>
        <p class="mono eyebrow">TEAM 812 ARCHIVE</p>
        <h2>Explore other seasons.</h2>
      </div>
      <a class="btn solid" href="/robots" style="align-self:center">
        ← Browse all robots
      </a>
    </div>
  </section>
</main>

<Footer />

</Base>
