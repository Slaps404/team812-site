---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import Split from '../components/Split.astro';
import Shot from '../components/Shot.astro';
import SeasonRobot from '../components/SeasonRobot.astro';
import LogoWall from '../components/LogoWall.astro';
import Tune from '../components/Tune.astro';
import { PAIR_IMAGE_SIZES } from '../lib/imageLayout';

import teamRobotImg from '../assets/photos/2026-states-team-robot-arena.jpg';
import drivetrainImg from '../assets/photos/2026-states-IMG_1033.jpg';
import workbenchImg from '../assets/photos/2026-season-workbench.jpeg';
const donationUrl = 'https://giveto.ucsd.edu/giving/home/?linkId=f84b6f44-4eb5-43e6-9468-5e756a2d4696';
---
<Base
  title="The Midnight Mechanics | FRC Team 812"
  description="FRC Team 812, The Midnight Mechanics, builds competition robots at The Preuss School UC San Diego."
>

<Nav current="home" />

<main class="view on" id="v-home">

  <Hero />

  <Stats />

  <section data-reveal>
    <div class="wrap">
      <h2>First-generation students building engineering futures</h2>
      <p class="body" style="margin-top:calc(var(--space) * 1.2)">The Preuss School UC San Diego is a charter school for low-income students. Our team is where they meet CAD, motor controllers, version control, and a hard deadline for the first time.</p>
      <div class="pair" style="margin-top:calc(var(--space) * 2.5)">
        <Shot src={drivetrainImg} alt="Students and a mentor working on the robot, with TEAM 812 on the bumper." sizes={PAIR_IMAGE_SIZES} />
        <Shot src={workbenchImg} alt="A student using a drill at a workshop workbench." sizes={PAIR_IMAGE_SIZES} />
      </div>
    </div>
  </section>

  <hr class="rule">

  <!-- This season's machine only. Older robots live in the archive. -->
  <SeasonRobot />

  <hr class="rule">

  <!-- The code archive is the strongest engineering proof on the homepage. -->
  <section data-reveal>
    <Split>
      <Fragment slot="left">
        <h2>Every line of our code since 2011.</h2>
        <p class="body" style="margin-top:calc(var(--space) * 1.2)">Sixteen consecutive seasons, all open-sourced. C++ from 2011 to 2015, Java since then.</p>
        <p class="body">We also ship our own tools. <b>ShooterTargeting</b> solves launch coefficients for a given shooter geometry. <b>ArmSim</b> listens on NetworkTables to simulate arm motion before the arm exists.</p>
        <div class="years">
          <a class="hi" href="https://github.com/preuss812/FRC_2026" target="_blank" rel="noopener">2026</a>
          <a href="https://github.com/preuss812/FRC_2025" target="_blank" rel="noopener">2025</a>
          <a href="https://github.com/preuss812/FRC_2024" target="_blank" rel="noopener">2024</a>
          <a href="https://github.com/preuss812/FRC_2023" target="_blank" rel="noopener">2023</a>
          <a href="https://github.com/preuss812/FRC_2022" target="_blank" rel="noopener">2022</a>
          <a href="https://github.com/preuss812/FRC_2020" target="_blank" rel="noopener">2020</a>
          <a href="https://github.com/preuss812/FRC_2019" target="_blank" rel="noopener">2019</a>
          <a href="https://github.com/preuss812/FRC_2018" target="_blank" rel="noopener">2018</a>
          <a href="https://github.com/preuss812/FRC_2017" target="_blank" rel="noopener">2017</a>
          <a href="https://github.com/preuss812/FRC_2016" target="_blank" rel="noopener">2016</a>
          <a href="https://github.com/preuss812/FRC_2015" target="_blank" rel="noopener">2015</a>
          <a href="https://github.com/preuss812/FRC_2014" target="_blank" rel="noopener">2014</a>
          <a href="https://github.com/preuss812/FRC_2013" target="_blank" rel="noopener">2013</a>
          <a href="https://github.com/preuss812/FRC_2012" target="_blank" rel="noopener">2012</a>
          <a href="https://github.com/preuss812/FRC_2011" target="_blank" rel="noopener">2011</a>
        </div>
      </Fragment>
      <Fragment slot="right">
        <Shot src={teamRobotImg} alt="Team 812 members with their competition robot at a REBUILT event." caption="Team 812 with Big Jiawei at a REBUILT event" tall />
      </Fragment>
    </Split>
  </section>

  <!-- Light panel. Corporate logos cannot sit on a dark ground.
       Keep this treatment aligned with the sponsors page. Sponsors close the
       homepage after the fundraising ask. -->
  <div class="panel" data-reveal>
    <div class="wrap">
      <h2 class="label">Sponsors</h2>
      <LogoWall />
    </div>
  </div>

  <section data-reveal>
    <div class="wrap">
      <h2>Close the <span id="gap-amount">$10,000</span> gap.</h2>
      <p class="body" style="margin-top:calc(var(--space) * 1.2)">Help fund Team 812’s 2027 season at The Preuss School.</p>
      <div class="cta" style="display:flex;gap:calc(var(--space) * .7);margin-top:calc(var(--space) * 1.6);flex-wrap:wrap">
        <a class="btn solid" href={donationUrl} target="_blank" rel="noopener noreferrer">Give to Team 812</a>
        <a class="btn ghost" href="/sponsors#tiers">View Sponsorship Tiers</a>
      </div>
    </div>
  </section>

  <script>
    const setupGapCounter = () => {
      const el = document.getElementById('gap-amount');
      if (!el) return;

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            observer.unobserve(entry.target);

            const target = 10000;
            const duration = 1350;
            const startTime = performance.now();

            const update = (now: number) => {
              const elapsed = now - startTime;
              const progress = Math.min(1, elapsed / duration);
              // Backwards exponential (easeInExpo)
              const ease = progress === 0 ? 0 : Math.pow(2, 10 * (progress - 1));
              const currentVal = Math.round(ease * target);

              el.textContent = `$${currentVal.toLocaleString()}`;

              if (progress < 1) {
                requestAnimationFrame(update);
              } else {
                el.textContent = `$${target.toLocaleString()}`;
              }
            };

            requestAnimationFrame(update);
          }
        });
      }, { threshold: 0.25 });

      observer.observe(el);
    };

    document.addEventListener('astro:page-load', setupGapCounter);
  </script>

</main>

<Footer />

<Tune />

</Base>
