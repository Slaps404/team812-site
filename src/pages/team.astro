---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Shot from '../components/Shot.astro';
import Roster from '../components/Roster.astro';
import { PAIR_IMAGE_SIZES } from '../lib/imageLayout';

import schoolImg from '../assets/photos/2026-states-IMG_0935.jpg';
import pitImg from '../assets/photos/2026-states-IMG_1045.jpg';
import drivetrainImg from '../assets/photos/2026-states-IMG_1033.jpg';

---
<Base
  title="Team | The Midnight Mechanics"
  description="Meet the students, mentors, and subteams behind FRC Team 812 at The Preuss School UC San Diego."
>

<Nav current="team" />

<main class="view on" id="v-team">

  <section data-reveal>
    <div class="wrap team-sections">
      <div>
        <p class="mono eyebrow">THE PEOPLE IN THE ROOM</p>
        <h1>A team is more than the robot.</h1>
      </div>
      <div class="team-copy">
        <p class="body">Students design, build, code, test, explain, and repair. Mentors make room for the next question rather than taking the tool away. What a student can do in April is the real output of the season.</p>
        <div class="team-roles">
          <div class="team-role">
            <h3>Students</h3>
            <p class="body">Own the design decisions, the code, and the pit. Most arrive with no engineering experience and leave able to run a subteam.</p>
          </div>
          <div class="team-role">
            <h3>Mentors</h3>
            <p class="body">Teachers, parents, and working engineers who coach, unblock, and keep the shop safe — without building the robot for anyone.</p>
            <a class="btn ghost team-role-link" href="/mentors" data-astro-prefetch>Meet the mentors</a>
          </div>
        </div>
        <p class="note">Names below are published with school permission, and only for students who opt in.</p>
      </div>
    </div>
  </section>

  <section id="roster" data-reveal style="padding-top:0">
    <div class="wrap">
      <div class="section-heading">
        <div>
          <p class="mono eyebrow">2026 ROSTER</p>
          <h2>Everyone on the team.</h2>
        </div>
        <p class="body">Students are listed with the subteam they spend the most time on. Most work across more than one.</p>
      </div>
      <Roster />
    </div>
  </section>

  <hr class="rule">

  <section data-reveal>
    <div class="wrap">
      <p class="mono eyebrow">IN THE PIT</p>
      <h2>What a competition weekend looks like.</h2>
      <div class="pair team-pair">
        <Shot src={pitImg} alt="Team 812 students and mentors working around their robot at the 2026 state championship." caption="Build crew preparing the robot between matches" sizes={PAIR_IMAGE_SIZES} />
        <Shot src={drivetrainImg} alt="Students and a mentor working on the robot, with TEAM 812 on the bumper." caption="Drivetrain repair in the pit area" sizes={PAIR_IMAGE_SIZES} />
      </div>
      <div class="team-wide-shot">
        <Shot src={schoolImg} alt="Team members at The Preuss School UC San Diego entrance sign." caption="Team 812 at The Preuss School UC San Diego, where the team has built since 2001" sizes="(max-width: 820px) calc(100vw - 3rem), min(100vw, 68rem)" />
      </div>
    </div>
  </section>

  <hr class="rule">

  <section data-reveal>
    <div class="wrap">
      <h2>Back the students who build it.</h2>
      <p class="body" style="margin-top:calc(var(--space) * 1.2)">Sponsorships fund parts, travel, and registration for the 2027 season. Preuss students and families can reach us by email about joining.</p>
      <div class="cta" style="display:flex;gap:calc(var(--space) * .7);margin-top:calc(var(--space) * 1.6);flex-wrap:wrap">
        <a class="btn solid" href="/sponsors">View sponsorship tiers</a>
        <a class="btn ghost" href="mailto:team812@preuss.ucsd.edu">team812@preuss.ucsd.edu</a>
      </div>
    </div>
  </section>

</main>

<Footer />

</Base>
