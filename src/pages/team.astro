---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

---

<Base
  title="Team | The Midnight Mechanics"
  description="Learn about FRC Team 812 at The Preuss School UC San Diego and find out when team profiles are ready."
>

<Nav current="team" />

<main class="view on" id="v-team">
  <section class="team-directory-hero" data-reveal>
    <div class="wrap">
      <h1 class="team-directory-title">TEAM 812</h1>
      <p class="body team-directory-lede">Team 812 is where Preuss students meet CAD, motor controllers, version control, and a hard deadline for the first time. Students build, wire, code, scout, and help bring the team to competition.</p>
      <p class="team-directory-meta mono">24 students <span aria-hidden="true">/</span> 5 mentors <span aria-hidden="true">/</span> 5 subteams <span aria-hidden="true">/</span> 6-week build season</p>
    </div>
  </section>

  <section class="team-directory-section team-coming-soon-section" data-reveal aria-labelledby="profiles-heading">
    <div class="wrap">
      <h2 class="team-directory-heading" id="profiles-heading">Team profiles</h2>
      <p class="body team-coming-soon-copy">Student and mentor profiles are coming soon. We are collecting names, photos, roles, and bios with approval before publishing them.</p>
      <a class="btn ghost" href="/contact" style="margin-top:calc(var(--space) * 1.6)">Contact Team 812</a>
    </div>
  </section>
</main>

<Footer />

</Base>
