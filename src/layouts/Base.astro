---
import { ClientRouter } from 'astro:transitions';
import '../styles/tokens.css';
import '../styles/global.css';
import socialImage from '../assets/photos/2026-states-IMG_1045.jpg';
import ImageViewer from '../components/ImageViewer.astro';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const socialImageUrl = new URL(socialImage.src, Astro.site ?? Astro.url);
---
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonicalUrl}>
<link rel="icon" href="/favicon.ico?v=812-badge" sizes="16x16 32x32 48x48">
<link rel="icon" href="/team812-icon-32.png" type="image/png" sizes="32x32">
<link rel="icon" href="/team812-icon-192.png" type="image/png" sizes="192x192">
<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">

<meta property="og:type" content="website">
<meta property="og:site_name" content="The Midnight Mechanics">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonicalUrl}>
<meta property="og:image" content={socialImageUrl}>
<meta property="og:image:width" content={String(socialImage.width)}>
<meta property="og:image:height" content={String(socialImage.height)}>
<meta property="og:image:alt" content="A Team 812 student and mentor working on the robot in the pit.">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={socialImageUrl}>
<meta name="twitter:image:alt" content="A Team 812 student and mentor working on the robot in the pit.">
<script is:inline>document.documentElement.classList.add('js');</script>
<ClientRouter />
<style is:inline>
  a, a:hover, a:focus, a:active, a:visited,
  .nav, .nav *, .mark, .mark *, .btn, .btn *,
  .robot-row, .robot-row *, .robot-btn, .robot-btn * {
    text-decoration: none !important;
    text-decoration-line: none !important;
    -webkit-text-decoration-line: none !important;
  }
</style>
</head>
<body class="flags">
<slot />
<ImageViewer />
<script is:inline>
  const enableMotionStyles = () => document.documentElement.classList.add('js');

  const setupReveal = () => {
    enableMotionStyles();
    const revealItems = [...document.querySelectorAll('[data-reveal]')];
    const reveal = (element) => element.classList.add('is-revealed');

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
      revealItems.forEach(reveal);
    } else {
      // Reveal once and stop watching: re-toggling on exit made the animation
      // replay every time an element scrolled back into view.
      const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach((entry) => {
if (entry.isIntersecting) {
            reveal(entry.target);
            entry.target.classList.add('is-revealed');
            obs.unobserve(entry.target);
          }
        });
      }, { threshold: 0.08, rootMargin: '0px 0px -4% 0px' });

      revealItems.forEach((element) => {
        if (element.classList.contains('is-revealed')) return;
        observer.observe(element);
      });
    }
  };

  // astro:page-load only fires on window 'load', which waits for every image.
  // Above-the-fold content would sit hidden until then, so start on DOM ready.
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupReveal, { once: true });
  } else {
    setupReveal();
  }

  document.addEventListener('astro:after-swap', enableMotionStyles);
  document.addEventListener('astro:page-load', setupReveal);
</script>
</body>
</html>
